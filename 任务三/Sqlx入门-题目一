package main

import (
	"fmt"

	"github.com/learn/samle-go/gorm/connectDb"
	"github.com/learn/samle-go/gorm/constant"
)

type employees struct {
	ID         uint    `gorm:"primaryKey"`
	Name       string  `gorm:"column:name"`
	Department string  `gorm:"column:department"`
	Salary     float64 `gorm:"column:salary"`
}
type Employee struct {
	ID         uint    `gorm:"primaryKey"`
	Name       string  `gorm:"column:name"`
	Department string  `gorm:"column:department"`
	Salary     float64 `gorm:"column:salary"`
}

func main() {
	// 初始化数据库
	dbConn := connectDb.InitDB(constant.DBPATH, &employees{})

	// 插入数据employees
