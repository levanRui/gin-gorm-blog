// 一对多  三张表关联
type User struct {
	ID    uint   `gorm:"primaryKey"`
	Name  string `gorm:"column:name"`
	Posts []Post `gorm:"foreignKey:UserReferId"`
}
type Post struct {
	ID          uint   `gorm:"primaryKey"`
	PostName    string `gorm:"column:postName"`
	UserReferId uint
	Comments    []Comment `gorm:"foreignKey:PostReferId"`
}
type Comment struct {
	ID          uint   `gorm:"primaryKey"`
	ComentName  string `gorm:"column:comentName"`
	PostReferId uint
}

