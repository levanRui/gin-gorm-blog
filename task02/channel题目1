package main

import (
	"fmt"
)

// 接受数据
func receiveData(ch <-chan int) {
	for value := range ch {
		fmt.Println("接收到数据：%d\n", value)
	}
}

// 发送数据
func sendData(ch chan<- int) {
	for i := 1; i <= 10; i++ {
		ch <- i
		fmt.Println("发送数据：%d\n", i)
	}
	close(ch)
}
func main() {
	// 初始化channel
	ch := make(chan int)
	//1.启动发送goroutine协程
	go sendData(ch)
	//2.启动接受goroutine协程
	go receiveData(ch)
	// 防止main函数过早结束，导致程序终止
	var input string
	fmt.Scanln(&input)

}
