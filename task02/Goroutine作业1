// 打印1到10的奇数
func printFunc1() {
	for i := 1; i < 11; i++ {
		if i%2 != 0 {
			fmt.Println("奇数goroutine: %d\n", i)
		}
		time.Sleep(150 * time.Millisecond)
	}
}

// 打印2到10的偶数
func printFunc2() {
	for i := 1; i < 11; i++ {
		if i%2 == 0 {
			fmt.Println("偶数goroutine: %d\n", i)
		}
		time.Sleep(150 * time.Millisecond)
	}
}
func main() {
	go printFunc1()
	go printFunc2()
	time.Sleep(2 * time.Second)
}
